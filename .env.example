# Apayee settings. Copy to .env (never commit .env). Every setting has a default;
# uncomment a line only to change it. Variables already set in the shell win over .env.
# Restart Apayee after editing.

# --- Network -------------------------------------------------------------------
# A non-loopback host needs APAYEE_ALLOW_REMOTE=true and a strong token. The claude
# provider never listens beyond loopback.
APAYEE_HOST=127.0.0.1
APAYEE_PORT=4100
# APAYEE_ALLOW_REMOTE=false

# --- Authentication ------------------------------------------------------------
# Bearer token: at least 32 characters, no whitespace, not repetitive, no placeholder
# wording. Required for APAYEE_PROVIDER=claude. QATOOL's APAYEE_TOKEN must equal it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APAYEE_AUTH_TOKEN=

# --- Provider ------------------------------------------------------------------
# mock (default, deterministic, no AI) or claude (experimental, owner-only).
APAYEE_PROVIDER=mock

# --- Queue, timeouts, limits ---------------------------------------------------
# Executions at once, 1 to 3. 1 is the tested default. Above 1 the Claude CLI processes
# share one sign-in, which is unverified: read "Concurrency" in docs/CLAUDE_PROVIDER.md.
# APAYEE_MAX_CONCURRENT=1
# APAYEE_MAX_QUEUE_SIZE=16
# APAYEE_MAX_QUEUE_WAIT_MS=600000
# APAYEE_DEFAULT_TIMEOUT_MS=180000
# APAYEE_MAX_TIMEOUT_MS=600000
# APAYEE_ABORT_GRACE_MS=2000
# APAYEE_SHUTDOWN_TIMEOUT_MS=10000
# APAYEE_MAX_BODY_BYTES=10485760
# APAYEE_MAX_SCHEMA_BYTES=262144
# APAYEE_LOG_LEVEL=info

# --- Claude provider (only read when APAYEE_PROVIDER=claude) --------------------
# Experimental and owner-only: it runs the official Claude Code CLI with your own signed-in
# subscription. Read docs/CLAUDE_PROVIDER.md first; the policy status is unconfirmed.
APAYEE_CLAUDE_EXPERIMENTAL=false
# Your own attestation, made after checking your plan in your Claude account settings.
# Apayee cannot verify a plan. Leave false until you have checked.
APAYEE_CLAUDE_SUBSCRIPTION_CONFIRMED=false
# Absolute path to claude.exe when it is not on PATH.
# APAYEE_CLAUDE_CLI_PATH=
# Model alias or name; unset uses the CLI's own default.
# APAYEE_CLAUDE_MODEL=
# Ceiling on one CLI run; the request's timeout_ms applies too and the shorter wins.
# APAYEE_CLAUDE_TIMEOUT_MS=300000
# Attempts the CLI may make to match the schema, 1 to 5. 1 means no internal retry.
# APAYEE_CLAUDE_STRUCTURED_OUTPUT_ATTEMPTS=1
# Extra variable NAMES the CLI may inherit, e.g. HTTPS_PROXY. Never credentials.
# APAYEE_CLAUDE_PASSTHROUGH_ENV=
# Set to 1 only for one run of `npm run claude:smoke`, which sends ONE real request.
# APAYEE_CLAUDE_SMOKE=
